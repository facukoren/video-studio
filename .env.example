# Local UI. Keep localhost binding for personal use and SSH forwarding.
HOST=127.0.0.1
PORT=4142
BASE_URL=http://127.0.0.1:4142
# Required for non-loopback binding. Use at least 32 random characters.
# A configured token is required even for connections from localhost/proxies.
APP_ACCESS_TOKEN=

# Your own Google Drive folder ID (not a URL). Restart API and worker after edits.
DRIVE_DESTINATION_FOLDER_ID=
# Import your own Web OAuth client JSON in Settings, or fill both below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_FILE=/absolute/private/path/google-client.json
# GOOGLE_REDIRECT_URI=http://127.0.0.1:4142/api/auth/google/callback

# Authenticate these CLIs using YOUR OWN accounts before starting the worker.
ASTRA_PATH=codex
# ASTRA_HOME=/absolute/private/path/to/.codex
HIGGSFIELD_PATH=higgsfield
HIGGSFIELD_WORKSPACE_ID=
HIGGSFIELD_MODEL=kling3_0

# Deploy the included Modal apps into YOUR OWN Modal account.
MODAL_MEDIA_APP=kavion-video-studio-media
MODAL_MEDIA_VOLUME=kavion-video-studio-media
# MODAL_MEDIA_ENVIRONMENT=
# MODAL_CONFIG_PATH=/absolute/private/path/modal.toml
PYTHON_PATH=python3
# DATA_DIR=/absolute/private/path/studio-data
# REFERENCE_VIDEO_PATH=/absolute/private/path/reference.mp4
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
