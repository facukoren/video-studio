{
  "name": "kavion-video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "worker": "node --env-file-if-exists=.env src/worker.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node --env-file-if-exists=.env scripts/browser-check.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "google-auth-library": "10.5.0",
    "gsap": "3.14.2",
    "hyperframes": "0.8.186"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "license": "MIT",
  "description": "Self-hosted video editing with word-level transcription, validated cuts, motion graphics and generated B-roll.",
  "repository": {
    "type": "git",
    "url": "https://github.com/facukoren/video-studio.git"
  }
}
