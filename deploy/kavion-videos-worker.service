[Unit]
Description=Kavion Video Studio processing worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/video-studio
ExecStart=/usr/bin/env node --env-file=.env src/worker.mjs
Restart=on-failure
RestartSec=65
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
